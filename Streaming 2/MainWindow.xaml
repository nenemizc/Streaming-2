<Window x:Class="Streaming_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Streaming Platform" Height="400" Width="550"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Leghosszabb tartalom" Click="BtnLongest_Click" Padding="5,2"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Keresés: " VerticalAlignment="Center"/>
            <TextBox x:Name="TxtSearch" Width="200" TextChanged="TxtSearch_TextChanged" VerticalAlignment="Center"/>
        </StackPanel>

        <ListBox x:Name="LstCatalog" Grid.Row="2" Margin="0,0,0,10"/>

        <TextBlock x:Name="TxtStatus" Grid.Row="3" Text="Kész." Foreground="Gray"/>
    </Grid>
</Window>